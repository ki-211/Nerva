# Nerva 本地环境变量示例
#
# 使用方法（在项目根目录执行）：
#   Copy-Item .env.example .env
# 然后只编辑新生成的 .env，不要在本示例文件中填写真实凭据。
# .env 已被 .gitignore 忽略；API Key、数据库密码和签名私钥也可以保存在部署平台的 Secret 中。

# =============================================================================
# AI 服务
# =============================================================================

# AI 服务商：
#   local   - 使用无需 API Key 的本地演示适配器，适合开发 UI 和接口联调。
#   bailian - 调用阿里云百炼；启用后必须填写 DASHSCOPE_API_KEY。
NERVA_AI_PROVIDER=local

# 阿里云百炼 API Key：在百炼控制台的 API Key 管理页面创建。
# local 模式下保持为空；禁止把真实 Key 写入 .env.example 或提交到 Git。
DASHSCOPE_API_KEY=

# 千问 AI 平台 OpenAI-compatible 公共 API 地址。
# 使用平台 API Key（sk-ws-...）时保持此地址，无需填写 Workspace ID。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 快速文本模型：用于普通文字理解、知识提取、摘要和 Markdown 生成。
NERVA_TEXT_MODEL=qwen3.7-plus

# OCR 模型：用于识别图片、截图、手写资料和扫描文档。
NERVA_OCR_MODEL=qwen3.5-ocr

# 向量模型：把知识切片和检索问题转换为向量，供 PostgreSQL + pgvector 语义检索。
# 向量模型或维度一旦用于正式数据，不应随意切换，否则需要重新生成全部向量。
NERVA_EMBEDDING_MODEL=text-embedding-v4

# 重排序模型：对初步召回的候选知识进行二次排序，提高 RAG 回答的相关性。
NERVA_RERANK_MODEL=qwen3-rerank

# =============================================================================
# PostgreSQL 数据库
# =============================================================================

# 完整数据库连接地址，可用于云数据库或自定义连接配置。
# 示例格式：postgresql+psycopg://用户名:密码@主机:5432/数据库名
# 保持为空时，后端会使用下方分开的 POSTGRES_* 配置；填写后将优先使用 DATABASE_URL。
# 如果用户名或密码包含 @、:、/、# 等字符，需要先进行 URL 编码。
DATABASE_URL=

# 本地 PostgreSQL 主机。数据库安装在本机时使用 127.0.0.1。
POSTGRES_HOST=127.0.0.1

# PostgreSQL 默认端口；如果 5432 已被占用，需要同时修改数据库端和这里。
POSTGRES_PORT=5432

# Nerva 使用的数据库名称。首次使用前需要确保该数据库已经创建。
POSTGRES_DB=nerva

# 本地开发默认使用安装 PostgreSQL 时创建的 postgres 管理员账号。
# 后续部署生产环境时应改用权限受限的 Nerva 专用账号。
POSTGRES_USER=postgres

# PostgreSQL 用户密码。请只在复制得到的 .env 中填写真实值。
POSTGRES_PASSWORD=

# Browser session and local web origin
NERVA_SESSION_COOKIE=nerva_session
NERVA_SESSION_DAYS=7
NERVA_COOKIE_SECURE=false
NERVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NERVA_CODE_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Login verification email (QQ Mail example: use an SMTP authorization code, not the mailbox password)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Nerva 团队
SMTP_USE_SSL=true

# Optional: reuse spring.mail settings from an existing local Spring Boot YAML file.
# Explicit SMTP_* environment variables above take precedence.
NERVA_SPRING_MAIL_CONFIG=
